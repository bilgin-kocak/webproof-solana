# Ed25519 signing key for the WebProof verifier: 32-byte seed as hex,
# base58, or a JSON byte array (a 64-byte Solana-style keypair is also
# accepted; its first 32 bytes are used). Never commit the real value.
WEBPROOF_SIGNER_KEY=

# Demo endpoint. Leave DEMO_URL unset to use the in-process TLSNotary test
# fixture (https://test-server.io/formats/json) — no external network needed.
DEMO_URL=
DEMO_FIELD=/meta/version

# Required allowlist for signing; comma-separated exact DNS hostnames.
WEBPROOF_ALLOWED_HOSTS=test-server.io

# Trusted notary verifying keys (comma-separated hex). Defaults to the key
# recorded by webproof-notarize (in-process notary demo).
#WEBPROOF_TRUSTED_NOTARY_KEYS=

# Claim lifetime in seconds.
CLAIM_TTL_SECONDS=300

# Where pipeline artifacts (presentation, signed claim) are written.
#WEBPROOF_ARTIFACT_DIR=artifacts/demo

SOLANA_RPC_URL=http://127.0.0.1:8899
#WEBPROOF_PROGRAM_ID=BU1KznoqTFTHgYpcvgFAS5AqqtqnwrrcjLAczpHwgKMR
#SOLANA_KEYPAIR=~/.config/solana/id.json

# MPC-TLS transcript limits (bytes); raise DEMO_MAX_RECV for large responses.
#DEMO_MAX_SENT=4096
#DEMO_MAX_RECV=16384
